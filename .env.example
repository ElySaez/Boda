# ─────────────────────────────────────────────────────────────
# Supabase — Proyecto (ver README para instrucciones de creación)
# ─────────────────────────────────────────────────────────────

# URL pública del proyecto Supabase. Segura de exponer al cliente.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (anon/public). Segura de exponer al cliente:
# el acceso real está controlado por las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio (service_role). NUNCA debe exponerse al navegador
# ni tener el prefijo NEXT_PUBLIC_. Solo se usa en Server Actions y
# Route Handlers que corren en el servidor.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ─────────────────────────────────────────────────────────────
# Sitio
# ─────────────────────────────────────────────────────────────

# URL pública donde se despliega el sitio (sin slash final).
# Usada para generar enlaces absolutos en el .ics y en emails/links compartidos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Limitación de solicitudes (RSVP)
# ─────────────────────────────────────────────────────────────

# Máximo de intentos de envío de RSVP permitidos por token/IP dentro
# de la ventana de tiempo definida abajo.
RSVP_RATE_LIMIT_MAX=5

# Duración de la ventana de limitación, en minutos.
RSVP_RATE_LIMIT_WINDOW_MINUTES=10
